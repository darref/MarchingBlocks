## The icon `name`, rendered `px` pixels wide (twice its display size keeps it sharp). Null, and said,
## when the name is unknown.
static func icon(name: String, px := 40) -> Texture2D:
	var key := "%s@%d" % [name, px]
	if _cache.has(key):
		return _cache[key]
	if not STROKES.has(name):
		push_error("MarchingBlocks: no icon named '%s'" % name)
		return null
	var image := Image.new()
	if image.load_svg_from_string(svg(STROKES[name]), px / 24.0) != OK:
		return null
	var texture := ImageTexture.create_from_image(image)
	_cache[key] = texture
	return texture


static func svg(strokes: String) -> String:
