extends SceneTree
##
## ÉCRIT LES ICÔNES DES TROIS GREFFONS depuis celles de l'appli (`app/icones.gd`, leur UNIQUE source) :
##   - Godot : `addons/marchingblocks_paint/mb_icons.gd`, les tracés SVG eux-mêmes (Godot les rend) ;
##   - Unity : `Editor/MBIcons.cs`, des PNG en base64 (Unity ne rend pas le SVG sans un paquet de plus,
##     et un PNG d'un paquet immuable demanderait des réglages d'import qu'on ne peut pas réécrire) ;
##   - Unreal : `Resources/Icons/<nom>.png`, lus par le style Slate du module éditeur.
##
## LANCEMENT
##   godot --headless --path D:/MarchingBlocks --script res://DEV_TOOLS/generer_icones_greffons.gd
##
## ⚠ UNE SECONDE COPIE DES TRACÉS DIVERGERAIT (§6) : on ne retouche jamais les fichiers écrits, on retouche
## `app/icones.gd` et on relance. `test_greffon_peinture` rougit si un fichier livré n'est plus celui que ce
## script produit. ⚠ Les PNG sont comparés OCTET PAR OCTET : un autre Godot peut les encoder autrement — on
## relance alors ce script, le test dit lequel.
## ⚠ Les noms sortent en ANGLAIS (§7) : la source des greffons part chez l'acheteur.

const Icones := preload("res://app/icones.gd")

## Nom du greffon → nom de l'appli. Seules celles dont un greffon se sert.
const NOMS := {
	"grid": "visee_grille", "sculpt": "visee_sculpt", "navigate": "visee_naviguer",
	"add": "ajouter", "dig": "creuser", "select": "selectionner", "rect": "rect", "box": "boite",
	"hollow": "evider", "sphere": "sphere", "cube": "cube", "disc": "disque", "floor": "etage",
	"fill": "remplir", "delete": "poubelle", "clear": "croix", "extrude_up": "extruder_haut",
	"extrude_down": "extruder_bas", "facing": "extruder_face", "widen": "elargir", "plant": "arbre", "grow": "grandir", "shrink": "retrecir", "connected": "connexe",
	"up": "haut", "down": "bas", "left": "gauche", "right": "droite", "move": "deplacer",
	"copy": "copier", "cut": "couper", "paste": "coller", "erase": "gomme", "layers": "couches",
	"world": "monde",
	"tunnel": "tunnel", "well": "puits", "bridge": "pont", "balcony": "balcon", "stairs": "escalier", "room": "salle",
	"straight": "droit", "variant": "variante",
	"connect": "relier", "round": "profil_rond", "square": "profil_carre", "arch": "profil_arche", "rail": "garde_corps",
}
## Rendues au double de leur taille d'affichage (20 px), comme dans l'appli : nettes à 200 %.
const PX := 40

const GODOT := "res://addons/marchingblocks_paint/mb_icons.gd"
const UNITY := "res://engines/unity/com.marchingblocks.paint/Editor/MBIcons.cs"
const UNITY_META := "res://engines/unity/com.marchingblocks.paint/Editor/MBIcons.cs.meta"
const UNREAL := "res://engines/unreal/MarchingBlocksPaint/Resources/Icons/"


func _initialize() -> void:
	var tout := sorties()
	if tout.has("erreur"):
		printerr(tout["erreur"])
		quit(1)
		return
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(UNREAL))
	for chemin in tout:
		var f := FileAccess.open(chemin, FileAccess.WRITE)
		if f == null:
			printerr("Icônes : impossible d'écrire %s" % chemin)
			quit(1)
			return
		f.store_buffer(tout[chemin])
		f.close()
	print("Icônes : %d fichiers écrits, %d icônes." % [tout.size(), NOMS.size()])
	quit(0)


## Chemin → octets, tout ce que ce script écrit. Le test compare le disque à ceci.
static func sorties() -> Dictionary:
	var r := {}
	var gd := PackedStringArray([
		"@tool",
		"extends RefCounted",
		"## MarchingBlocks' own icons, as SVG strokes: white, so the theme tints them.",
		"##",
		"## GENERATED by DEV_TOOLS/generer_icones_greffons.gd from the MarchingBlocks tool's icons —",
		"## do not edit by hand, the tool's are the source.",
		"",
		"const STROKES := {",
	])
	var cs := PackedStringArray([
		"// MarchingBlocks' own icons, as white PNGs (the GUI colour tints them).",
		"//",
		"// GENERATED by DEV_TOOLS/generer_icones_greffons.gd from the MarchingBlocks tool's icons — do not",
		"// edit by hand, the tool's are the source.",
		"",
		"using System.Collections.Generic;",
		"using UnityEngine;",
		"",
		"namespace MarchingBlocks.Paint.EditorTools",
		"{",
		"    static class MBIcons",
		"    {",
		"        static readonly Dictionary<string, string> Png = new Dictionary<string, string>",
		"        {",
	])
	var noms: Array = NOMS.keys()
	noms.sort()
	for nom in noms:
		var source: String = NOMS[nom]
		if not Icones.TRACES.has(source):
			return {"erreur": "Icônes : « %s » n'existe plus dans app/icones.gd" % source}
		var trace: String = Icones.TRACES[source]
		gd.append("\t\"%s\": '%s'," % [nom, trace])
		var image := Image.new()
		if image.load_svg_from_string(svg(trace), PX / 24.0) != OK:
			return {"erreur": "Icônes : « %s » ne se rend pas" % source}
		var png := image.save_png_to_buffer()
		cs.append("            { \"%s\", \"%s\" }," % [nom, Marshalls.raw_to_base64(png)])
		r[UNREAL + nom + ".png"] = png
	gd.append_array([
		"}",
		"",
		"static var _cache := {}",
		"",
		"",
		"## The icon `name`, rendered `px` pixels wide (twice its display size keeps it sharp). Null, and said,",
		"## when the name is unknown.",
		"static func icon(name: String, px := 40) -> Texture2D:",
		"\tvar key := \"%s@%d\" % [name, px]",
		"\tif _cache.has(key):",
		"\t\treturn _cache[key]",
		"\tif not STROKES.has(name):",
		"\t\tpush_error(\"MarchingBlocks: no icon named '%s'\" % name)",
		"\t\treturn null",
		"\tvar image := Image.new()",
		"\tif image.load_svg_from_string(svg(STROKES[name]), px / 24.0) != OK:",
		"\t\treturn null",
		"\tvar texture := ImageTexture.create_from_image(image)",
		"\t_cache[key] = texture",
		"\treturn texture",
		"",
		"",
		"static func svg(strokes: String) -> String:",
		"\treturn ('%s'" % ENTETE,
		"\t\t+ strokes + \"</svg>\")",
		"",
	])
	cs.append_array([
		"        };",
		"",
		"        static readonly Dictionary<string, Texture2D> Cache = new Dictionary<string, Texture2D>();",
		"",
		"        /// <summary>The icon <paramref name=\"name\"/>, 40 px, white. Null when the name is unknown.</summary>",
		"        public static Texture2D Get(string name)",
		"        {",
		"            if (Cache.TryGetValue(name, out var t) && t != null) return t;",
		"            if (!Png.TryGetValue(name, out var data)) { Debug.LogError($\"MarchingBlocks: no icon named '{name}'\"); return null; }",
		"            t = new Texture2D(2, 2, TextureFormat.RGBA32, false) { hideFlags = HideFlags.HideAndDontSave, filterMode = FilterMode.Bilinear };",
		"            t.LoadImage(System.Convert.FromBase64String(data));",
		"            Cache[name] = t;",
		"            return t;",
		"        }",
		"    }",
		"}",
		"",
	])
	r[GODOT] = "\n".join(gd).to_utf8_buffer()
	r[UNITY] = "\n".join(cs).to_utf8_buffer()
	r[UNITY_META] = ("fileFormatVersion: 2\nguid: 6d1f0c4e8b7a4f5c9e2d3a1b0c9f8e7d\nMonoImporter:\n"
		+ "  externalObjects: {}\n  serializedVersion: 2\n  defaultReferences: []\n  executionOrder: 0\n"
		+ "  icon: {instanceID: 0}\n  userData: \n  assetBundleName: \n  assetBundleVariant: \n").to_utf8_buffer()
	return r


const ENTETE := Icones.ENTETE


static func svg(trace: String) -> String:
	return ENTETE + trace + "</svg>"
