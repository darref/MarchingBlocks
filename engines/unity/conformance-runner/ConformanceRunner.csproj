<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Unity plugin's placement rule against conformance.json, outside Unity.
       It compiles the SAME files the Unity package ships: Runtime/MBRule.cs, MBJson.cs, MBTools.cs,
       MBWorldFile.cs, and the tools, world and aim checks of Tests/Editor. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../com.marchingblocks.paint/Runtime/MBRule.cs" Link="MBRule.cs" />
    <Compile Include="../com.marchingblocks.paint/Runtime/MBJson.cs" Link="MBJson.cs" />
    <Compile Include="../com.marchingblocks.paint/Runtime/MBTools.cs" Link="MBTools.cs" />
    <Compile Include="../com.marchingblocks.paint/Runtime/MBShapes.cs" Link="MBShapes.cs" />
    <Compile Include="../com.marchingblocks.paint/Tests/Editor/ToolsConformanceCheck.cs" Link="ToolsConformanceCheck.cs" />
    <Compile Include="../com.marchingblocks.paint/Runtime/MBWorldFile.cs" Link="MBWorldFile.cs" />
    <Compile Include="../com.marchingblocks.paint/Tests/Editor/WorldConformanceCheck.cs" Link="WorldConformanceCheck.cs" />
    <Compile Include="../com.marchingblocks.paint/Tests/Editor/AimCheck.cs" Link="AimCheck.cs" />
    <Compile Include="../com.marchingblocks.paint/Tests/Editor/LayeredConformanceCheck.cs" Link="LayeredConformanceCheck.cs" />
    <Compile Include="../com.marchingblocks.paint/Tests/Editor/VariantConformanceCheck.cs" Link="VariantConformanceCheck.cs" />
    <Compile Include="../com.marchingblocks.paint/Tests/Editor/ParityCheck.cs" Link="ParityCheck.cs" />
    <Compile Include="../com.marchingblocks.paint/Tests/Editor/EditingConformanceCheck.cs" Link="EditingConformanceCheck.cs" />
    <Compile Include="../com.marchingblocks.paint/Runtime/MBAnimation.cs" Link="MBAnimation.cs" />
    <Compile Include="../com.marchingblocks.paint/Tests/Editor/AnimationConformanceCheck.cs" Link="AnimationConformanceCheck.cs" />
    <Compile Include="../com.marchingblocks.paint/Runtime/MBTransitions.cs" Link="MBTransitions.cs" />
    <Compile Include="../com.marchingblocks.paint/Runtime/MBFoliage.cs" Link="MBFoliage.cs" />
    <Compile Include="../com.marchingblocks.paint/Runtime/MBWater.cs" Link="MBWater.cs" />
    <Compile Include="../com.marchingblocks.paint/Tests/Editor/TransitionsConformanceCheck.cs" Link="TransitionsConformanceCheck.cs" />
    <Compile Include="../com.marchingblocks.paint/Tests/Editor/FoliageConformanceCheck.cs" Link="FoliageConformanceCheck.cs" />
    <Compile Include="../com.marchingblocks.paint/Tests/Editor/WaterConformanceCheck.cs" Link="WaterConformanceCheck.cs" />
    <Compile Include="../com.marchingblocks.paint/Runtime/MBWaterMesh.cs" Link="MBWaterMesh.cs" />
    <Compile Include="../com.marchingblocks.paint/Tests/Editor/WaterMeshConformanceCheck.cs" Link="WaterMeshConformanceCheck.cs" />
    <Compile Include="../com.marchingblocks.paint/Tests/Editor/WaterIncrementalCheck.cs" Link="WaterIncrementalCheck.cs" />
    <Compile Include="../com.marchingblocks.paint/Runtime/MBWheel.cs" Link="MBWheel.cs" />
    <Compile Include="../com.marchingblocks.paint/Tests/Editor/WheelCheck.cs" Link="WheelCheck.cs" />
  </ItemGroup>
</Project>
