<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Unity plugin's placement rule against conformance.json, outside Unity.
       It compiles the SAME files the Unity package ships: Runtime/MBRule.cs, MBJson.cs, MBTools.cs,
       MBWorldFile.cs, and the tools and world checks of Tests/Editor. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../com.marchingblocks.paint/Runtime/MBRule.cs" Link="MBRule.cs" />
    <Compile Include="../com.marchingblocks.paint/Runtime/MBJson.cs" Link="MBJson.cs" />
    <Compile Include="../com.marchingblocks.paint/Runtime/MBTools.cs" Link="MBTools.cs" />
    <Compile Include="../com.marchingblocks.paint/Tests/Editor/ToolsConformanceCheck.cs" Link="ToolsConformanceCheck.cs" />
    <Compile Include="../com.marchingblocks.paint/Runtime/MBWorldFile.cs" Link="MBWorldFile.cs" />
    <Compile Include="../com.marchingblocks.paint/Tests/Editor/WorldConformanceCheck.cs" Link="WorldConformanceCheck.cs" />
  </ItemGroup>
</Project>
