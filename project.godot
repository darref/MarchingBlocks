; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Undermend"
config/description="Un greffon Godot pour peindre des tuiles 3D non cubiques dans un GridMap."
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://MARQUE/embleme.png"

[display]

window/size/viewport_width=640
window/size/viewport_height=320
window/size/mode=3
window/size/window_width_override=1280
window/size/window_height_override=640

[editor_plugins]

enabled=PackedStringArray("res://addons/kenyoni/plugin_reloader/plugin.cfg", "res://addons/undermend/plugin.cfg")

[rendering]

renderer/rendering_method.mobile="forward_plus"
