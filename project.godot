; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MarchingBlocks"
config/description="Sculpt one block. Paint a world. Non-cubic 3D tiles for Godot, Unity and Unreal."
config/version="0.9.2"
run/main_scene="res://app/editor.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://MARQUE/icone.png"
config/use_custom_user_dir.edition_demo=true
config/custom_user_dir_name.edition_demo="MarchingBlocks Demo"
boot_splash/bg_color=Color(0.16, 0.12, 0.22, 1)
boot_splash/image="res://MARQUE/splash.png"
boot_splash/stretch_mode=4

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2

[editor_plugins]

enabled=PackedStringArray("res://addons/kenyoni/plugin_reloader/plugin.cfg", "res://addons/marchingblocks_paint/plugin.cfg")

[rendering]

renderer/rendering_method.mobile="forward_plus"
