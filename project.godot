; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Undermend"
config/description="Réparer le monde vu de dessus en résolvant les énigmes enfouies dans les profondeurs, vues de côté."
run/main_scene="res://DEV_TOOLS/greybox_ecran_partage.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://MARQUE/embleme.png"

[autoload]

Entrees="*res://CLIENT/entrees.gd"
Fenetre="*res://CLIENT/fenetre.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=160
window/size/window_width_override=1280
window/size/window_height_override=640
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
