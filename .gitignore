# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Les lots de tuiles achetés entrent au dépôt (le projet les référence par res://), mais pas leurs
# archives Unity : plusieurs mégaoctets qu'aucun Godot ne lira jamais.
*.unitypackage

# Android et exports
/android/
/build/

# Le PBR espace monde : des dérivés des textures de Spirit3D, rebâtis par DEV_TOOLS/batir_pbr_monde.gd.
ART/pbr_monde/

# Les exécutables exportés : ils se refont par l'export, et ils sont lourds.
build/

# L'exemple livré (`DEV_TOOLS/prendre_l_exemple.gd`) est repris du projet de Jordan à chaque export tant que le
# développement n'est pas clos : il n'entre au dépôt qu'une fois FIGÉ (`exemple/FIGE`), avec son archive.
exemple/exemple.zip

# Le cœur natif (gdextension/) : les objets et la base de scons se refont ; les BIBLIOTHÈQUES, elles, entrent au dépôt
# (addons/marchingblocks_core/natif/bin/) pour que l'éditeur les trouve sans construire.
gdextension/.sconsign.dblite
gdextension/src/**/*.o
gdextension/src/**/*.os
gdextension/src/**/*.obj
